@page "/equipments/bysubid/{id:guid}"
@using SM.Shared
@inject HttpClient Http
@inject NavigationManager NavigationManager


<PageTitle>Equipments</PageTitle>

<h1>Equipments</h1>
@if (equipments == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Substation</th>
                <th>Customer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipment in equipments)
            {
                var isSelected = selectedTransformerId == equipment.Id;
                <tr class="@GetRowClass(isSelected)" @onclick="@(() => OnRowClick(equipment))"
                    @onkeydown="@(e => OnRowKeyDown(e, equipment))" tabindex="0" aria-selected="@isSelected">
                    <td>@equipment.Name</td>
                    <td>@equipment?.Asset?.AssetType?.Name</td>
                    <td>@equipment?.Asset?.Substation?.Name</td>
                    <td>@equipment?.Asset?.Customer?.Name</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TransformerDto> equipments = new List<TransformerDto>();
    [Parameter] public Guid id { get; set; }

    private Guid? selectedTransformerId;
    void GoToListReports(Guid id) => NavigationManager.NavigateTo($"/auditreports/byequid/{id}");
    protected override async Task OnInitializedAsync()
    {
        equipments = await Http.GetFromJsonAsync<List<TransformerDto>>($"http://localhost:5124/transformers/bysubid/{id}") ??
        [];
    }

    private void OnRowClick(TransformerDto transformer)
    {
        selectedTransformerId = transformer.Id;
        GoToListReports(transformer.Id);
    }

    private void OnRowKeyDown(KeyboardEventArgs e, TransformerDto transformer)
    {
        // Support keyboard accessibility (Enter/Space to “click” the row)
        if (e.Key is "Enter" or " ")
        {
            OnRowClick(transformer);
        }
    }

    private string GetRowClass(bool isSelected) => isSelected ? "table-active" : "";
}