@page "/auditreports/byequid/{id:guid}"
@using SM.Shared
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavigationManager


<PageTitle>Audit Reports</PageTitle>

<h1>Audit Reports</h1>
<!-- Form to add a new customer -->
<div class="mb-3">
    <button @onclick="GoToCreate">Add New Report</button>
</div>
@if (reports == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Report Number</th>
                <th>Substation</th>
                <th>Customer</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AuditReportDto report in reports)
            {
                <tr>
                    <td>@report.DateServiced</td>
                    <td>@report.ReportNumber</td>
                    <td>@report.SubstationId</td>
                    <td>@report.CustomerId</td>
                    <td>
                        <button @onclick="() => GoToEdit(report.Id)" disabled="@report.Submitted">Edit</button>
                    </td>
                    <td>
                        <button @onclick="() => GoToSubmit(report)" disabled="@report.Submitted">Submit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AuditReportDto> reports = new List<AuditReportDto>();
    [Parameter] public Guid id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        reports = await Http.GetFromJsonAsync<List<AuditReportDto>>($"http://localhost:5124/auditreports/byequid/{id}") ?? [];
    }

    void GoToCreate() => NavigationManager.NavigateTo("/auditreports/create");
    void GoToEdit(Guid id) => NavigationManager.NavigateTo($"/auditreports/edit/{id}");
    async Task GoToSubmit(AuditReportDto report)
    {
        var response = await Http.PutAsJsonAsync($"http://localhost:5124/auditreports/submit/{report.Id}", report);
        if (response.IsSuccessStatusCode)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "Audit Report submitted successfully");
            if (confirmed)
            {
                NavigationManager.NavigateTo("/auditreports");
            }
        }
        else
        {
            // Optionally show an alert for failure
            await JS.InvokeAsync<object>("alert", "Submission failed. Please try again or contact support.");
        }
    }
}