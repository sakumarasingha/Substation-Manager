@page "/auditreports/create"
@using SM.Shared
@using SM.WebPwa.Pages.Reports.Shared
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h3>Create Equipment</h3>

<TransformerAuditForm Report="newReport" OnValidSubmit="AddAuditReport" />

@code {
    private AuditReportDto newReport = new AuditReportDto();

    private async Task AddAuditReport(AuditReportDto Equipment)
    {
        var response = await Http.PostAsJsonAsync("http://localhost:5124/auditreports", newReport);

        if (response.IsSuccessStatusCode)
        {
            var created = await response.Content.ReadFromJsonAsync<AuditReportDto>();
            if (created is not null)
            {
                NavigationManager.NavigateTo("/auditreports");
            }
        }
        else
        {
            // Handle error (log, show message, etc.)
        }
    }

}